        border: 1px solid #ccc;
        width: 250px;
    }
    
    .search-input:focus {
        border-color: #fe424d;
        box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.15);
        outline: none;
    }
    
    .search-form {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
</style>


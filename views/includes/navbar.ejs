        padding: 0.45rem 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        white-space: nowrap;
    }
    
    .btn-search:hover {
        background-color: #d9363e;
        color: #fff;
        border-color: #d9363e;
    }
    
    .btn-search i {
        color: #fff;
        font-size: 1rem;
        margin: 0;
    }
    
    .search-input {
        border-radius: 25px;
